NP_CORE_ADDR=localhost:7000
NP_CORE_KEY=change-me-core-internal-key-change-me-internal!
NP_HTTP_ADDR=:8536
NP_UBS_DATABASE_URL=postgres://np_ubs:change-me@postgres/np_ubs?sslmode=disable
NP_TICKET_KEY=/run/ps3/np-ticket-key.pem
# 20 bytes: vsh 0x683fb8 XOR 0x7F (resource key slot 9). Keep out of git.
NP_UBS_RESOURCE_KEY=/run/ps3/np-ubstorage-resource-key.bin
# Host the console is told to use (ubstorage-fqdn); it must resolve to np-account.
NP_UBS_FQDN=ubs.np.community.playstation.net
# Optional: origin used in icon-url (default http://$NP_UBS_FQDN).
#NP_UBS_ICON_BASE=http://ubs.np.community.playstation.net
# Optional limits in bytes (defaults 1 GiB each).
#NP_UBS_ACCOUNT_QUOTA=1073741824
#NP_UBS_SAVE_MAX=1073741824
